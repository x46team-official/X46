{
  "info": {
    "name": "X46 LIMS - Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Chunk 0.3 - JWT auth core",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationCode\": \"ORG001\",\n  \"branchCode\": \"BR001\",\n  \"username\": \"jdoe\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "response": [
            {
              "name": "200 OK - Valid credentials",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"organizationCode\": \"ORG001\",\n  \"branchCode\": \"BR001\",\n  \"username\": \"jdoe\",\n  \"password\": \"secret123\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"token\": \"<jwt>\",\n    \"expiresAt\": \"2026-09-08T14:05:49Z\",\n    \"userId\": \"<uuid>\",\n    \"organizationId\": \"<uuid>\",\n    \"branchId\": \"<uuid>\",\n    \"roles\": [\"<uuid>\"]\n  }\n}"
            },
            {
              "name": "401 Unauthorized - Invalid credentials",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"organizationCode\": \"ORG001\",\n  \"branchCode\": \"BR001\",\n  \"username\": \"jdoe\",\n  \"password\": \"wrong\"\n}"
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"error\": \"Invalid credentials\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
