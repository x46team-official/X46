{
  "functionality_id": "API-014",
  "module": "Department Management",
  "functionality": "Update Department",
  "http_method": "PUT",
  "endpoint": "/api/organizations/{organizationId}/branches/{branchId}/departments/{departmentId}",
  "description": "Updates an existing department's code, name, and description.",

  "request": {
    "path_parameters": { "organizationId": "uuid, required", "branchId": "uuid, required", "departmentId": "uuid, required" },
    "query_parameters": {},
    "headers": {},
    "body": {
      "departmentCode": "string(30), required at API layer",
      "departmentName": "string(100), required",
      "description": "text, optional"
    }
  },

  "required_fields": ["organizationId", "branchId", "departmentId", "departmentCode", "departmentName"],

  "validation": [
    "department must exist and belong to organization + branch",
    "departmentName must not be null",
    "departmentCode/departmentName must remain unique within organization + branch"
  ],

  "success": {
    "status_code": 200,
    "response": {
      "success": true,
      "message": "Department updated successfully",
      "data": {
        "id": "uuid",
        "departmentCode": "BIO",
        "departmentName": "Biochemistry Updated",
        "isActive": true
      }
    }
  },

  "errors": [
    {
      "condition": "departmentCode or departmentName missing",
      "status_code": 400,
      "response": { "success": false, "error": "Validation error" }
    },
    {
      "condition": "organizationId, branchId, or departmentId not found / department not in scope",
      "status_code": 404,
      "response": { "success": false, "error": "Department not found" }
    },
    {
      "condition": "departmentCode or departmentName collides with another department in the same organization + branch",
      "status_code": 409,
      "response": { "success": false, "error": "Duplicate department code/name" }
    },
    {
      "condition": "Unexpected server/database failure",
      "status_code": 500,
      "response": { "success": false, "error": "Internal server error" }
    }
  ],

  "database": {
    "tables": ["department_master"],
    "relationships": [],
    "constraints": [
      "department_name NOT NULL",
      "UNIQUE (organization_id, branch_id, department_name)",
      "UNIQUE (organization_id, branch_id, department_code)"
    ]
  },

  "scope": { "organization_required": true, "branch_required": true },

  "e2e_reference": ["database/e2e-validation/002_master_data.sql"],

  "test_ids": ["API-T189"],
  "notes": "No dedicated api_contracts_test SQL file existed yet for Department Management; API-T189 is a net-new ID continuing the global sequence (previous max was API-T186) and still needs a backing api_contracts_test script."
}
