{
  "functionality_id": "API-077",
  "module": "Worklist Management",
  "functionality": "Create Worklist",
  "http_method": "POST",
  "endpoint": "/api/worklists",
  "description": "Creates a worklist master entry used to group accession tests for processing within a department.",
  "request": {
    "path_parameters": {},
    "query_parameters": {},
    "headers": {},
    "body": {
      "organizationId": "uuid, required",
      "branchId": "uuid, required",
      "departmentId": "uuid, required - references department_master.id",
      "worklistCode": "string(30), required",
      "worklistName": "string(100), required",
      "description": "text, optional",
      "estimatedTatMinutes": "integer, optional"
    }
  },
  "required_fields": [
    "organizationId",
    "branchId",
    "departmentId",
    "worklistCode",
    "worklistName"
  ],
  "validation": [
    "organization and branch must exist",
    "departmentId must reference an existing department_master row (NOT NULL FK)",
    "worklistCode must be unique within organization + branch (uq_worklist_code)",
    "worklistName must be unique within organization + branch (uq_worklist_name)"
  ],
  "success": {
    "status_code": 201,
    "response": {
      "success": true,
      "message": "Worklist created successfully",
      "data": {
        "id": "uuid",
        "organizationId": "uuid",
        "branchId": "uuid",
        "departmentId": "uuid",
        "worklistCode": "WL001",
        "worklistName": "Hematology Worklist",
        "estimatedTatMinutes": 60,
        "isActive": true
      }
    }
  },
  "errors": [
    {
      "condition": "departmentId does not reference an existing department",
      "status_code": 404,
      "response": {
        "success": false,
        "error": "Department not found"
      },
      "source": "database/api_contracts_test/017_worklist.sql (API-T139)",
      "related_functionality_id": "API-080"
    },
    {
      "condition": "worklistCode already exists for the organization + branch",
      "status_code": 409,
      "response": {
        "success": false,
        "error": "Duplicate worklist code"
      },
      "source": "database/api_contracts_test/017_worklist.sql (API-T140)",
      "related_functionality_id": "API-081"
    },
    {
      "condition": "worklistName already exists for the organization + branch",
      "status_code": 409,
      "response": {
        "success": false,
        "error": "Duplicate worklist name"
      },
      "source": "database/api_contracts_test/017_worklist.sql (API-T141)",
      "related_functionality_id": "API-082"
    },
    {
      "condition": "Unexpected server/database failure",
      "status_code": 500,
      "response": {
        "success": false,
        "error": "Internal server error"
      }
    }
  ],
  "database": {
    "tables": [
      "worklist_master",
      "department_master"
    ],
    "relationships": [
      "worklist_master.department_id -> department_master.id"
    ],
    "constraints": [
      "department_id NOT NULL",
      "uq_worklist_code UNIQUE (organization_id, branch_id, worklist_code)",
      "uq_worklist_name UNIQUE (organization_id, branch_id, worklist_name)"
    ]
  },
  "scope": {
    "organization_required": true,
    "branch_required": true
  },
  "e2e_reference": [
    "database/e2e-validation/009_worklist.sql",
    "database/api_contracts_test/017_worklist.sql"
  ],
  "test_ids": [
    "API-T136"
  ]
}
