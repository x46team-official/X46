{
  "functionality_id": "API-017",
  "module": "Patient Management",
  "functionality": "View Patient",
  "http_method": "GET",
  "endpoint": "/api/organizations/{organizationId}/branches/{branchId}/patients/{patientId}",
  "description": "Retrieves a single patient demographic record scoped to organization and branch.",

  "request": {
    "path_parameters": { "organizationId": "uuid, required", "branchId": "uuid, required", "patientId": "uuid, required" },
    "query_parameters": {},
    "headers": {},
    "body": "None"
  },

  "required_fields": ["organizationId", "branchId", "patientId"],

  "validation": [
    "patientId must be a valid UUID",
    "patient must exist and belong to the specified organization + branch"
  ],

  "success": {
    "status_code": 200,
    "response": {
      "success": true,
      "message": "Patient fetched successfully",
      "data": {
        "id": "uuid",
        "organizationId": "uuid",
        "branchId": "uuid",
        "firstName": "Rahul",
        "lastName": "Sharma",
        "gender": "MALE",
        "dateOfBirth": "1995-05-10",
        "isActive": true
      }
    }
  },

  "errors": [
    {
      "condition": "patientId is not a valid UUID",
      "status_code": 400,
      "response": { "success": false, "error": "Invalid patient ID" },
      "source": "database/api_contracts_test/010_patient_management.sql (API-T063)"
    },
    {
      "condition": "patient does not exist / not in organization+branch scope",
      "status_code": 404,
      "response": { "success": false, "error": "Patient not found" },
      "source": "database/api_contracts_test/010_patient_management.sql (API-T068)"
    }
  ],

  "database": {
    "tables": ["patients"],
    "relationships": [],
    "constraints": []
  },

  "scope": { "organization_required": true, "branch_required": true },

  "e2e_reference": ["database/api_contracts_test/010_patient_management.sql"],

  "test_ids": ["API-T062", "API-T063", "API-T068"]
}
