{
  "functionality_id": "API-043",
  "module": "Accession",
  "functionality": "Create Accession",
  "http_method": "POST",
  "endpoint": "/api/organizations/{organizationId}/branches/{branchId}/accessions",
  "description": "Creates a new accession (accession_master) against a bill and patient registration.",

  "request": {
    "path_parameters": { "organizationId": "uuid, required", "branchId": "uuid, required" },
    "query_parameters": {},
    "headers": {},
    "body": {
      "billingId": "uuid, required - references billing_master.id",
      "patientRegistrationId": "uuid, required - references patient_registrations.id",
      "accessionNumber": "string(30), required",
      "accessionDate": "timestamp with time zone, optional - defaults to server current timestamp",
      "priority": "enum, optional - NORMAL | URGENT | STAT, default NORMAL",
      "status": "enum, optional - PENDING | PARTIALLY_COLLECTED | COLLECTED | PROCESSING | COMPLETED | CANCELLED, default PENDING",
      "remarks": "text, optional"
    }
  },

  "required_fields": ["organizationId", "branchId", "billingId", "patientRegistrationId", "accessionNumber"],

  "validation": [
    "billingId must reference an existing bill (NOT NULL FK)",
    "patientRegistrationId must reference an existing registration (NOT NULL FK)",
    "accessionNumber must not be null (NOT NULL)",
    "accessionNumber must be unique within organization + branch (UNIQUE uq_accession_number)",
    "priority, if provided, must be one of NORMAL, URGENT, STAT (CHECK)",
    "status, if provided, must be one of PENDING, PARTIALLY_COLLECTED, COLLECTED, PROCESSING, COMPLETED, CANCELLED (CHECK)"
  ],

  "success": {
    "status_code": 201,
    "response": {
      "success": true,
      "message": "Accession created successfully",
      "data": {
        "id": "uuid",
        "organizationId": "uuid",
        "branchId": "uuid",
        "billingId": "uuid",
        "patientRegistrationId": "uuid",
        "accessionNumber": "ACC-API-101",
        "priority": "NORMAL",
        "status": "PENDING",
        "isActive": true
      }
    }
  },

  "errors": [
    {
      "condition": "accessionNumber missing/null, or priority/status not a recognized enum value",
      "status_code": 400,
      "response": { "success": false, "error": "Validation error" }
    },
    {
      "condition": "billingId does not reference an existing bill",
      "status_code": 404,
      "response": { "success": false, "error": "Billing not found" },
      "source": "database/api_contracts_test/014_accession.sql",
      "related_functionality_id": "API-054"
    },
    {
      "condition": "patientRegistrationId does not reference an existing registration",
      "status_code": 404,
      "response": { "success": false, "error": "Registration not found" },
      "source": "database/api_contracts_test/014_accession.sql",
      "related_functionality_id": "API-055"
    },
    {
      "condition": "accessionNumber already exists within organization + branch",
      "status_code": 409,
      "response": { "success": false, "error": "Duplicate accession number" },
      "source": "database/api_contracts_test/014_accession.sql",
      "related_functionality_id": "API-053"
    },
    {
      "condition": "Unexpected server/database failure",
      "status_code": 500,
      "response": { "success": false, "error": "Internal server error" }
    }
  ],

  "database": {
    "tables": ["accession_master", "billing_master", "patient_registrations"],
    "relationships": [
      "accession_master.billing_id -> billing_master.id",
      "accession_master.patient_registration_id -> patient_registrations.id"
    ],
    "constraints": [
      "billing_id NOT NULL",
      "patient_registration_id NOT NULL",
      "accession_number NOT NULL",
      "UNIQUE (organization_id, branch_id, accession_number) -- uq_accession_number",
      "priority CHECK IN (NORMAL, URGENT, STAT)",
      "status CHECK IN (PENDING, PARTIALLY_COLLECTED, COLLECTED, PROCESSING, COMPLETED, CANCELLED)"
    ]
  },

  "scope": { "organization_required": true, "branch_required": true },

  "e2e_reference": [
    "database/e2e-validation/006_accession.sql",
    "database/api_contracts_test/014_accession.sql"
  ],

  "test_ids": ["API-T101"]
}
