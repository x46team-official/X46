{
  "functionality_id": "API-133",
  "module": "Report",
  "functionality": "View Report",
  "description": "Reads a generated report. Generate and Finalize are already covered by existing contracts and are not duplicated here.",

  "reused_apis": [
    { "functionality_id": "API-100", "functionality": "Generate Report", "note": "Already covers 'Generate report'." },
    { "functionality_id": "API-106", "functionality": "Release Report", "note": "Already covers 'Finalize report' - marks report_master.report_status = RELEASED." }
  ],

  "operations": [
    {
      "operation": "View Report",
      "http_method": "GET",
      "endpoint": "/api/reports/{reportId}",
      "request": {
        "path_parameters": { "organizationId": "uuid, required", "branchId": "uuid, required", "reportId": "uuid, required" },
        "query_parameters": {},
        "body": "None"
      },
      "required_fields": ["organizationId", "branchId", "reportId"],
      "validation": ["reportId must exist and belong to organization + branch"],
      "success": {
        "status_code": 200,
        "response": {
          "success": true,
          "message": "Report fetched successfully",
          "data": {
            "id": "uuid", "accessionId": "uuid", "reportNumber": "RPT-ACC0001", "versionNo": 1, "reportStatus": "RELEASED",
            "generatedAt": "timestamp with time zone", "authorizedAt": "timestamp with time zone", "releasedAt": "timestamp with time zone",
            "pdfPath": "string", "qrCode": "string",
            "deliveries": [ { "deliveryType": "EMAIL", "recipientType": "PATIENT", "deliveryStatus": "DELIVERED", "deliveredAt": "timestamp with time zone" } ]
          }
        }
      },
      "errors": [
        { "condition": "reportId not found / not in organization+branch scope", "status_code": 404, "response": { "success": false, "error": "Report not found" } }
      ]
    }
  ],

  "database": {
    "tables": ["report_master", "report_delivery_log"],
    "relationships": ["report_delivery_log.report_id -> report_master.id"],
    "constraints": ["report_status CHECK IN (DRAFT, GENERATED, AUTHORIZED, RELEASED, CANCELLED)"]
  },

  "scope": { "organization_required": true, "branch_required": true },

  "e2e_reference": [],
  "notes": "Net-new contract; no e2e-validation or api_contracts_test coverage exists yet. The `deliveries` array reuses report_delivery_log so this view doubles as a lightweight delivery-status summary; API-135 (Report Delivery) provides the full delivery listing/filtering endpoint."
}
